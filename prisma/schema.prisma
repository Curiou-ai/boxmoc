generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPPLIER
  LOGISTICS
}

enum UserStatus {
  ACTIVE
  CHURNED
  ONBOARDING
  TRIALING
}

enum PrintStatus {
  PENDING
  READY
  PRINTING
  COMPLETED
  SHIPPED
}

enum WaitlistStatus {
  WAITLISTED
  ACTIVE
  REDEEMED
}

model User {
  id                       String      @id @default(uuid())
  email                    String      @unique
  displayName              String?
  photoURL                 String?
  role                     UserRole    @default(USER)
  tenantId                 String?     @unique
  stripeCustomerId         String?     @unique
  stripeSubscriptionId     String?
  stripePriceId            String?
  stripeCurrentPeriodEnd   Int?
  stripeSubscriptionStatus String?
  status                   UserStatus  @default(ONBOARDING)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  lastActiveAt             DateTime?
  
  designs                  Design[]
  orders                   Order[]
  assets                   Asset[]
  notes                    Note[]
}

model Design {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  boxTier     String   // e.g., 'shipper', 'retailer', 'bespoke'
  dimensions  Json     // { width: number, height: number, depth: number }
  canvasJson  Json?    // SVG coordinates: x, y, rotation, scale
  logoSvgUrl  String?
  previewUrl  String?
  createdAt   DateTime @default(now())
  
  orders      Order[]
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  designId         String
  design           Design      @relation(fields: [designId], references: [id])
  shopifyOrderId   String?     @unique
  shopifyOrderName String?     // e.g. #1024
  amountTotal      Int         // in cents
  quantity         Int         @default(1)
  printStatus      PrintStatus @default(PENDING)
  shippingAddress  Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  status    String   @default("new") // e.g., 'new', 'contacted', 'closed'
  source    String   @default("web_form")
  createdAt DateTime @default(now())
  notes     Note[]
}

model Waitlist {
  id        String         @id @default(uuid())
  email     String         @unique
  status    WaitlistStatus @default(WAITLISTED)
  code      String?        @unique
  source    String?
  createdAt DateTime       @default(now())
}

model Asset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())
}

model Supplier {
  id           String   @id @default(uuid())
  name         String
  location     String
  capabilities String[]
  rating       Float    @default(0.0)
  capacity     Int      @default(0)
  costPerUnit  Int      // in cents
  createdAt    DateTime @default(now())
}

model Note {
  id        String             @id @default(uuid())
  content   String
  author    String
  userId    String?
  user      User?              @relation(fields: [userId], references: [id])
  contactId String?
  contact   ContactSubmission? @relation(fields: [contactId], references: [id])
  createdAt DateTime           @default(now())
}