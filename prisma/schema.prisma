generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPPLIER
  LOGISTICS
}

enum PrintStatus {
  PENDING
  READY
  PRINTING
  COMPLETED
  SHIPPED
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  displayName              String?
  photoURL                 String?
  role                     Role      @default(USER)
  tenantId                 String    @unique
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   Int?
  status                   String    @default("active")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastActiveAt             DateTime?
  designs                  Design[]
  orders                   Order[]
  assets                   Asset[]
  notes                    Note[]
}

model Design {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  boxTier        String
  width          Float
  height         Float
  depth          Float
  canvasJson     Json
  logoSvgUrl     String?
  previewUrl     String
  createdAt      DateTime @default(now())
  orders         Order[]
}

model Order {
  id               String      @id @default(uuid())
  shopifyOrderId   String      @unique
  shopifyOrderName String
  designId         String
  design           Design      @relation(fields: [designId], references: [id])
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  quantity         Int
  amountTotal      Int
  printStatus      PrintStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  paidAt           DateTime?
  shippingAddress  Json?
}

model Asset {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  url       String
  name      String
  type      String
  size      Int
  createdAt DateTime @default(now())
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("waitlisted")
  code      String?  @unique
  source    String?
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  source    String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  author    String
  createdAt DateTime @default(now())
}
