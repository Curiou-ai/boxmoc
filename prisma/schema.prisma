generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPPLIER
  LOGISTICS
}

enum PrintStatus {
  PENDING
  READY
  PRINTING
  COMPLETED
  SHIPPED
}

model User {
  id                       String   @id @default(uuid())
  email                    String   @unique
  displayName              String?
  photoURL                 String?
  role                     Role     @default(USER)
  tenantId                 String   @unique
  stripeCustomerId         String?  @unique
  stripeSubscriptionId     String?
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   Int?
  status                   String?  @default("active")
  createdAt                DateTime @default(now())
  lastActiveAt             DateTime @updatedAt
  
  designs                  Design[]
  orders                   Order[]
  notes                    Note[]
}

model Design {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  boxTier     String   // shipper, retailer, bespoke
  dimensions  Json     // { width, height, depth }
  canvasJson  Json?
  logoSvgUrl  String?
  previewUrl  String
  createdAt   DateTime @default(now())
  
  orders      Order[]
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  designId         String
  design           Design      @relation(fields: [designId], references: [id])
  shopifyOrderId   String      @unique
  shopifyOrderName String
  quantity         Int
  amountTotal      Int         // In cents
  printStatus      PrintStatus @default(PENDING)
  shippingAddress  Json?
  createdAt        DateTime    @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  source    String?  @default("web_form")
  status    String?  @default("new")
  createdAt DateTime @default(now())
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("waitlisted") // waitlisted, active, redeemed
  code      String?
  source    String?  @default("web_form")
  createdAt DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  author    String
  createdAt DateTime @default(now())
}
