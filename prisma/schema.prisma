// Prisma schema for Boxmoc - Production SaaS Architecture

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPPLIER
  LOGISTICS
}

enum PrintStatus {
  PENDING
  READY
  PRINTING
  COMPLETED
  SHIPPED
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  displayName            String?
  photoURL               String?
  role                   Role      @default(USER)
  tenantId               String    @unique
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd Int?
  stripeSubscriptionStatus String?
  status                 String    @default("active")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  lastActiveAt           DateTime?
  
  designs                Design[]
  orders                 Order[]
  notes                  Note[]
}

model Design {
  id          String   @id @default(uuid())
  userId      String
  boxTier     String   // "shipper", "retailer", "bespoke"
  dimensions  Json     // { width, height, depth }
  canvasJson  Json?    // Stores SVG coordinates: x, y, rotation, scale
  logoSvgUrl  String?
  previewUrl  String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  designId         String
  shopifyOrderId   String      @unique
  shopifyOrderName String
  quantity         Int
  amountTotal      Int         // In cents
  printStatus      PrintStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  shippingAddress  Json?
  paidAt           DateTime?

  user             User        @relation(fields: [userId], references: [id])
  design           Design      @relation(fields: [designId], references: [id])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  location    String
  costPerUnit Int      // In cents
  rating      Float    @default(5.0)
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("waitlisted") // "waitlisted", "active", "redeemed"
  code      String?  @unique
  source    String?
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  status    String   @default("new")
  source    String?
  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id                  String             @id @default(uuid())
  content             String
  author              String
  createdAt           DateTime           @default(now())
  userId              String?
  contactSubmissionId String?
  
  user                User?              @relation(fields: [userId], references: [id])
  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])
}
