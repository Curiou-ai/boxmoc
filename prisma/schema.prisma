generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPPLIER
  LOGISTICS
}

enum PrintStatus {
  PENDING
  READY
  PRINTING
  COMPLETED
  SHIPPED
}

model b_User {
  id                       String   @id @default(uuid())
  email                    String   @unique
  emailVerified            Boolean  @default(false)
  displayName              String?
  photoURL                 String?
  role                     Role     @default(USER)
  tenantId                 String   @unique
  stripeCustomerId         String?  @unique
  stripeSubscriptionId     String?
  stripePriceId            String?
  stripeSubscriptionStatus String?
  stripeCurrentPeriodEnd   Int?
  status                   String?  @default("active")
  createdAt                DateTime @default(now())
  lastActiveAt             DateTime @updatedAt

  designs b_Design[]
  orders  b_Order[]
  notes   b_Note[]
  sessions      b_Session[]
  accounts      b_Account[]
}

model b_Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      b_User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model b_Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  b_User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // Better Auth handles cryptographic hashing securely here
  createdAt             DateTime
  updatedAt             DateTime
}

model b_Design {
  id         String   @id @default(uuid())
  userId     String
  user       b_User     @relation(fields: [userId], references: [id])
  boxTier    String // shipper, retailer, bespoke
  dimensions Json // { width, height, depth }
  canvasJson Json?
  logoSvgUrl String?
  previewUrl String
  createdAt  DateTime @default(now())

  orders b_Order[]
}

model b_Order {
  id               String      @id @default(uuid())
  userId           String
  user             b_User        @relation(fields: [userId], references: [id])
  designId         String
  design           b_Design      @relation(fields: [designId], references: [id])
  shopifyOrderId   String      @unique
  shopifyOrderName String
  quantity         Int
  amountTotal      Int // In cents
  printStatus      PrintStatus @default(PENDING)
  shippingAddress  Json?
  gcodeUrl         String? // Path to the G-code file for 3D printing
  createdAt        DateTime    @default(now())
}

model b_Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String
  source    String?  @default("web_form")
  status    String?  @default("new")
  createdAt DateTime @default(now())
}

model b_Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("waitlisted") // waitlisted, active, redeemed
  code      String?
  source    String?  @default("web_form")
  createdAt DateTime @default(now())
}

model b_Note {
  id        String   @id @default(uuid())
  userId    String
  user      b_User     @relation(fields: [userId], references: [id])
  content   String
  author    String
  createdAt DateTime @default(now())
}
