{
    "name": "whatsapp-agent",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
      "dev": "wrangler dev",
      "deploy": "wrangler deploy",
      "db:migrate:local": "wrangler d1 execute whatsapp-agent-db --local --file=./src/db/schema.sql",
      "db:migrate:remote": "wrangler d1 execute whatsapp-agent-db --remote --file=./src/db/schema.sql",
      "test": "vitest run",
      "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
      "@cloudflare/vitest-pool-workers": "^0.5.0",
      "@cloudflare/workers-types": "^4.20250101.0",
      "typescript": "^5.5.0",
      "vitest": "^1.6.0",
      "wrangler": "^3.80.0"
    }
  }